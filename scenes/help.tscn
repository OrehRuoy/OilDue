[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/help.gd" id="1_help"]
[ext_resource type="Script" path="res://scripts/back_to_settings.gd" id="2_back"]
[ext_resource type="Texture2D" path="res://assets/icons/back.png" id="3_back"]
[ext_resource type="Script" path="res://scripts/safe_area.gd" id="4_safe"]
[ext_resource type="Script" path="res://scripts/page_column.gd" id="5_page"]

[node name="Help" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_help")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.101961, 0.090196, 0.078431, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16
script = ExtResource("4_safe")

[node name="PageHost" type="HBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("5_page")

[node name="Column" type="VBoxContainer" parent="Margin/PageHost"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Back" type="Button" parent="Margin/PageHost/Column"]
custom_minimum_size = Vector2(88, 44)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"NavBack"
text = "Back"
icon = ExtResource("3_back")
expand_icon = true
script = ExtResource("2_back")

[node name="Title" type="Label" parent="Margin/PageHost/Column"]
layout_mode = 2
theme_type_variation = &"ScreenTitle"
text = "Help"

[node name="HelpScroll" type="ScrollContainer" parent="Margin/PageHost/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="GroupHelp" type="PanelContainer" parent="Margin/PageHost/Column/HelpScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="HelpText" type="VBoxContainer" parent="Margin/PageHost/Column/HelpScroll/GroupHelp"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Line1" type="Label" parent="Margin/PageHost/Column/HelpScroll/GroupHelp/HelpText"]
layout_mode = 2
autowrap_mode = 3
text = "This is a notebook for oil, tires, brakes. Not CARFAX."

[node name="Line2" type="Label" parent="Margin/PageHost/Column/HelpScroll/GroupHelp/HelpText"]
layout_mode = 2
autowrap_mode = 3
text = "Date reminders need the OS permission; mileage overdue only shows in the app."

[node name="Line3" type="Label" parent="Margin/PageHost/Column/HelpScroll/GroupHelp/HelpText"]
layout_mode = 2
autowrap_mode = 3
text = "Import: in VMT, export CSV, then Files → On My iPhone → Oil Due."

[node name="Line4" type="Label" parent="Margin/PageHost/Column/HelpScroll/GroupHelp/HelpText"]
layout_mode = 2
autowrap_mode = 3
text = "Backup zip is how dates survive a new phone."

[node name="Line5" type="Label" parent="Margin/PageHost/Column/HelpScroll/GroupHelp/HelpText"]
layout_mode = 2
autowrap_mode = 3
text = "Intervals are typical, not your dealer's schedule. Check the glovebox book."

[node name="Line6" type="Label" parent="Margin/PageHost/Column/HelpScroll/GroupHelp/HelpText"]
layout_mode = 2
autowrap_mode = 3
text = "Everything stays on this iPhone. No account."
